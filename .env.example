# Server and authentication
PORT=8788
AUTH_MODE=dev
RESOURCE_SERVER_URL=http://localhost:8788
AUTH0_ISSUER=
JWT_AUDIENCES=
JWT_CLIENT_IDS=
REQUIRED_SCOPES=openid
LOG_LEVEL=INFO

# Request controls
PANEL_TIMEOUT_SECONDS=90
PANEL_MAX_OUTPUT_TOKENS=1200
PANEL_MAX_CONCURRENCY=7

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Hugging Face Inference Providers
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen3-Coder-480B-A35B-Instruct:cheapest
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Kimi / Moonshot
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# xAI / Grok
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1

# Optional OpenAI-compatible Colab endpoints. Excluded from the default panel.
LLAMA_COLAB_API_KEY=
LLAMA_COLAB_MODEL=
LLAMA_COLAB_BASE_URL=
QWEN_COLAB_API_KEY=
QWEN_COLAB_MODEL=
QWEN_COLAB_BASE_URL=

# Optional future document preprocessing
LLAMA_CLOUD_API_KEY=
